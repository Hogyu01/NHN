{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeDependencyRegistry",
  "type": "object",
  "required": ["schemaVersion", "dependencies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dependencyId", "package", "version", "officialDistributionUrl", "verifiedAt", "localEntry", "localSha256", "lockfile", "licenseId", "noticePath"]
      }
    }
  }
}
